{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus-platform.local/lotus-workbench/workbench-runtime-state-inventory.v1.schema.json",
  "title": "Workbench runtime state inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "owner",
    "governedByIssue",
    "reviewedOn",
    "nextReviewBy",
    "architecturePosture",
    "durableBusinessStateOwner",
    "durableSessionStateOwner",
    "stateHolders",
    "frameworkFeaturePolicy",
    "explicitNonClaims"
  ],
  "properties": {
    "contract": { "const": "workbench-runtime-state-inventory.v1" },
    "owner": { "const": "lotus-workbench" },
    "governedByIssue": { "const": 619 },
    "reviewedOn": { "$ref": "#/$defs/date" },
    "nextReviewBy": { "$ref": "#/$defs/date" },
    "architecturePosture": {
      "enum": ["scale-proof-in-progress", "multi-instance-certified"]
    },
    "durableBusinessStateOwner": {
      "const": "upstream-source-services"
    },
    "durableSessionStateOwner": { "$ref": "#/$defs/nonEmptyString" },
    "stateHolders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stateHolder" }
    },
    "frameworkFeaturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverActions",
        "nextDataCache",
        "incrementalStaticRegeneration",
        "onDemandRevalidation",
        "businessFetchCacheMode",
        "sharedCacheInfrastructure"
      ],
      "properties": {
        "serverActions": { "const": "prohibited-until-reviewed" },
        "nextDataCache": { "const": "prohibited-for-source-owned-business-data" },
        "incrementalStaticRegeneration": { "const": "not-used" },
        "onDemandRevalidation": { "const": "not-used" },
        "businessFetchCacheMode": { "const": "no-store" },
        "sharedCacheInfrastructure": {
          "const": "not-required-by-current-feature-usage"
        }
      }
    },
    "explicitNonClaims": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "items": {
        "enum": [
          "production-high-availability",
          "disaster-recovery-certification",
          "bank-capacity-certification",
          "production-identity-certification"
        ]
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "temporaryException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "expiresOn", "requiredRemediation"],
      "properties": {
        "issue": { "const": 619 },
        "expiresOn": { "$ref": "#/$defs/date" },
        "requiredRemediation": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "stateHolder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "symbols",
        "classification",
        "purpose",
        "bounds",
        "replicaBehavior",
        "businessAuthority",
        "sessionAuthority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "file": {
          "type": "string",
          "pattern": "^src/.+\\.(?:ts|tsx)$"
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        },
        "classification": {
          "enum": [
            "immutable_lookup",
            "immutable_configuration",
            "browser_guarded_cache",
            "browser_inflight",
            "browser_ephemeral",
            "process_initialization",
            "instance_telemetry"
          ]
        },
        "purpose": { "$ref": "#/$defs/nonEmptyString" },
        "bounds": { "$ref": "#/$defs/nonEmptyString" },
        "replicaBehavior": { "$ref": "#/$defs/nonEmptyString" },
        "businessAuthority": { "const": false },
        "sessionAuthority": { "const": false },
        "temporaryException": { "$ref": "#/$defs/temporaryException" }
      }
    }
  }
}
