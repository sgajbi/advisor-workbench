{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lotus.example/contracts/workbench-screen-registry.schema.json",
  "title": "Lotus Workbench screen registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "owner",
    "governingIssue",
    "guideStandard",
    "routeEntrypoints",
    "surfaces",
    "modeAuthorities"
  ],
  "properties": {
    "$schema": { "const": "./workbench-screen-registry.schema.json" },
    "schemaVersion": { "const": "lotus.workbench.screen-registry.v1" },
    "owner": { "const": "lotus-workbench" },
    "governingIssue": { "type": "integer", "minimum": 1 },
    "guideStandard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templatePath", "catalogueSlug", "requiredHeadings"],
      "properties": {
        "templatePath": { "type": "string", "minLength": 1 },
        "catalogueSlug": { "type": "string", "minLength": 1 },
        "requiredHeadings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^## " }
        }
      }
    },
    "routeEntrypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeEntrypoint" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "modeAuthorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/modeAuthority" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "routeEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "routePattern",
        "routeClassification",
        "navigationPosture",
        "canonicalSurfaceIds",
        "implementationEvidence"
      ],
      "properties": {
        "entrypoint": { "type": "string", "pattern": "^src/app/.*/?page\\.tsx$|^src/app/page\\.tsx$" },
        "routePattern": { "type": "string", "pattern": "^/" },
        "routeClassification": {
          "enum": [
            "active-supported-screen",
            "active-route-container",
            "compatibility-route",
            "alias-redirect"
          ]
        },
        "navigationPosture": {
          "enum": ["active", "runtime-capability-gated", "capability-disabled", "compatibility-only"]
        },
        "canonicalSurfaceIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "implementationEvidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "coverageException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "plannedSlice", "reason"],
      "properties": {
        "issue": { "type": "integer", "minimum": 1 },
        "plannedSlice": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "businessName",
        "family",
        "routePattern",
        "surfaceClassification",
        "navigationPosture",
        "sourceOwners",
        "implementationEvidence",
        "runtimeEvidence",
        "supportOwner"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "businessName": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "routePattern": { "type": "string", "pattern": "^/" },
        "mode": { "type": ["string", "null"] },
        "fragment": { "type": ["string", "null"] },
        "surfaceClassification": {
          "enum": ["active-screen", "active-mode", "alias", "capability-disabled", "roadmap-only"]
        },
        "navigationPosture": {
          "enum": ["active", "runtime-capability-gated", "capability-disabled", "compatibility-only", "not-applicable"]
        },
        "wikiSlug": { "type": ["string", "null"] },
        "canonicalSurfaceId": { "type": "string", "minLength": 1 },
        "sourceOwners": { "$ref": "#/$defs/nonEmptyStrings" },
        "implementationEvidence": { "$ref": "#/$defs/nonEmptyStrings" },
        "runtimeEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "supportOwner": { "type": "string", "minLength": 1 },
        "issue": { "type": "integer", "minimum": 1 },
        "coverageException": {
          "oneOf": [
            { "$ref": "#/$defs/coverageException" },
            { "type": "null" }
          ]
        }
      }
    },
    "modeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "source", "symbol", "extraction", "surfaceMappings"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "extraction": { "enum": ["definition-keys", "type-union"] },
        "surfaceMappings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
