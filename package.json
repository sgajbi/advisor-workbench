{
  "name": "lotus-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22 <23",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10 <11",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/quality/clean-next-build-artifacts.mjs && next build && npm run quality:portfolio-record-bundles",
    "start": "next start",
    "lint": "npm run quality:runtime-support && npm run quality:dependency-risk && npm run lint:css-global && npm run lint:risk-architecture && npm run quality:screen-docs && npm run lint:eslint",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:css-global": "node scripts/quality/check-css-global-governance.mjs",
    "lint:risk-architecture": "node scripts/quality/check-risk-architecture.mjs",
    "quality:screen-docs": "node scripts/quality/check-workbench-screen-documentation.mjs",
    "quality:runtime-support": "node scripts/quality/check-runtime-support-policy.mjs",
    "quality:dependency-risk": "node scripts/quality/check-dependency-risk-inventory.mjs",
    "quality:portfolio-record-bundles": "node scripts/quality/check-portfolio-record-bundles.mjs",
    "lint:react-compiler": "eslint src --config eslint.react-compiler.config.mjs --max-warnings=0",
    "security:audit": "npm audit --audit-level=high && npm audit --omit=dev --audit-level=moderate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:runtime-ownership": "node scripts/quality/run-canonical-port-ownership-contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:performance:populated": "node scripts/testing/run-performance-smoke-scenario.mjs populated",
    "test:e2e:performance:unavailable": "node scripts/testing/run-performance-smoke-scenario.mjs unavailable",
    "test:e2e:portfolio:cashflow": "node scripts/testing/run-portfolio-smoke-scenario.mjs cashflow",
    "test:e2e:reports:states": "node scripts/testing/run-report-centre-smoke-scenario.mjs",
    "live:stack:down": "powershell -ExecutionPolicy Bypass -File scripts/live/Stop-LotusFrontOfficeCanonical.ps1",
    "live:stack:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/live/Start-LotusFrontOfficeCanonical.ps1 -PortOwnershipPreflightOnly",
    "live:stack:up": "powershell -ExecutionPolicy Bypass -File scripts/live/Start-LotusFrontOfficeCanonical.ps1",
    "live:stack:up:core-manage": "powershell -ExecutionPolicy Bypass -File scripts/live/Start-LotusFrontOfficeCanonical.ps1 -CoreManageOnly",
    "live:stack:up:core-manage:build": "powershell -ExecutionPolicy Bypass -File scripts/live/Start-LotusFrontOfficeCanonical.ps1 -CoreManageOnly -BuildImages",
    "live:stack:up:workbench-local": "powershell -ExecutionPolicy Bypass -File scripts/live/Start-LotusFrontOfficeCanonical.ps1 -LocalApps workbench",
    "live:stack:up:validate": "powershell -ExecutionPolicy Bypass -File scripts/live/Start-LotusFrontOfficeCanonical.ps1 -RunValidation -BuildImages",
    "live:validate": "powershell -ExecutionPolicy Bypass -File scripts/live/Validate-LotusFrontOfficeCanonical.ps1",
    "live:validate:construction": "playwright test tests/live/construction-alternatives.live.spec.ts --config playwright.live.config.ts",
    "live:validate:ui": "node scripts/live/validate-canonical-workbench-live.mjs",
    "live:evidence": "powershell -ExecutionPolicy Bypass -File scripts/live/Capture-LotusFrontOfficeEvidence.ps1",
    "auto:pulse": "powershell -ExecutionPolicy Bypass -File scripts/automation/Platform-Pulse.ps1",
    "auto:sync": "powershell -ExecutionPolicy Bypass -File scripts/automation/Sync-Repos.ps1",
    "auto:pr": "powershell -ExecutionPolicy Bypass -File scripts/automation/PR-Monitor.ps1",
    "auto:agent": "powershell -ExecutionPolicy Bypass -File scripts/automation/Run-Agent.ps1",
    "auto:agent:once": "powershell -ExecutionPolicy Bypass -File scripts/automation/Run-Agent.ps1 -Once",
    "auto:refresh:pas": "powershell -ExecutionPolicy Bypass -File scripts/automation/Service-Refresh.ps1 -ProjectPath C:/Users/Sandeep/projects/lotus-core -Services"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.2.2",
    "@mui/material": "7.3.4",
    "@tanstack/react-query": "5.90.5",
    "ag-grid-community": "34.3.1",
    "ag-grid-react": "34.3.1",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.65.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.22",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.23",
    "postcss-value-parser": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "minimatch": {
      "brace-expansion": "5.0.9"
    },
    "test-exclude": "8.0.0",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
